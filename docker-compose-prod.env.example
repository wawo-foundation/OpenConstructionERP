# Copy this file to .env beside the production compose files, then replace every
# placeholder. Shared Postgres, Redis, SeaweedFS S3, and Qdrant services must be
# reachable through one of the two external Docker networks below.

BE_COMPOSE_PROJECT_NAME=openconstructionerp-be-prod
FE_COMPOSE_PROJECT_NAME=openconstructionerp-fe-prod
APP_NAME=openconstructionerp

PRIVATE_DB_NETWORK=net_private_db
PRIVATE_WEB_NETWORK=net_private_web

BACKEND_IMAGE=openconstructionerp-be-prod:local
FRONTEND_IMAGE=openconstructionerp-fe-prod:local

ALLOWED_ORIGINS=https://erp.example.com
FRONTEND_URL=https://erp.example.com
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8080

# Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME

# Shared PostgreSQL
DB_HOST_NAME=shared-postgres
DB_PORT=5432
DB_USER=oe
DB_PASSWORD=CHANGE_ME
DB_NAME=openconstructionerp

# Shared Redis. Keep cache and Celery on separate Redis databases.
REDIS_URL=redis://:CHANGE_ME@shared-redis:6379/0
CELERY_BROKER_URL=redis://:CHANGE_ME@shared-redis:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGE_ME@shared-redis:6379/2
CELERY_CONCURRENCY=2

# Shared SeaweedFS S3 gateway, not a MinIO endpoint.
S3_ENDPOINT=http://shared-seaweedfs-s3:8333
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=openconstructionerp
S3_REGION=us-east-1

# Shared Qdrant
QDRANT_URL=http://shared-qdrant:6333

LOG_LEVEL=INFO
